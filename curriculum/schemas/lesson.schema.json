{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://art-course.local/schemas/lesson.v3.schema.json",
  "title": "Art course lesson record",
  "description": "Version 3 lesson data contract. Published pilot lessons add structured teaching while development fixtures retain the base fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "durationMinutes",
    "difficulty",
    "medium",
    "materials",
    "lessonType",
    "fundamentals",
    "concepts",
    "prerequisites",
    "objective",
    "warmup",
    "explanation",
    "visuals",
    "exercise",
    "artistReferences",
    "bookReferences",
    "reflection",
    "status",
    "label"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "durationMinutes": { "type": "integer", "minimum": 1, "maximum": 600 },
    "difficulty": { "type": "string", "minLength": 1 },
    "medium": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "materials": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "lessonType": { "type": "string", "minLength": 1 },
    "fundamentals": { "$ref": "#/$defs/fundamentals" },
    "concepts": { "type": "array", "items": { "$ref": "#/$defs/concept" } },
    "prerequisites": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "objective": { "type": "string", "minLength": 1 },
    "warmup": { "$ref": "#/$defs/warmup" },
    "explanation": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "visuals": { "type": "array", "items": { "$ref": "#/$defs/visual" } },
    "exercise": { "$ref": "#/$defs/exercise" },
    "artistReferences": { "type": "array", "items": { "type": "string" } },
    "bookReferences": { "type": "array", "items": { "$ref": "#/$defs/bookReference" } },
    "reflection": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "teaching": { "$ref": "#/$defs/teaching" },
    "sourceImages": { "type": "array", "items": { "$ref": "#/$defs/privateSourceImage" } },
    "extension": { "type": "string" },
    "scaffoldingLevel": { "type": "string" },
    "status": { "enum": ["development-fixture", "published"] },
    "label": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "development-fixture" } }, "required": ["status"] },
      "then": { "properties": { "label": { "const": "DEVELOPMENT FIXTURE — NOT FINAL CURRICULUM" } } }
    },
    {
      "if": { "properties": { "status": { "const": "published" } }, "required": ["status"] },
      "then": { "required": ["teaching"], "properties": { "label": { "const": "" } } }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1
    },
    "conceptStage": {
      "type": "string",
      "enum": ["introduced", "practised", "revisited", "combined", "independent"]
    },
    "fundamentals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary"],
      "properties": {
        "primary": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "secondary": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "stage"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "stage": { "$ref": "#/$defs/conceptStage" }
      }
    },
    "warmup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durationMinutes", "instructions"],
      "properties": {
        "durationMinutes": { "type": "integer", "minimum": 1, "maximum": 60 },
        "instructions": { "type": "string", "minLength": 1 }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "alt", "provenance"],
      "properties": {
        "src": { "type": "string", "minLength": 1 },
        "alt": { "type": "string", "minLength": 1 },
        "caption": { "type": "string" },
        "provenance": { "$ref": "#/$defs/inlineProvenance" }
      }
    },
    "inlineProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "creator": { "type": "string" },
        "license": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durationMinutes", "instructions", "source", "subjectType"],
      "properties": {
        "durationMinutes": { "type": "integer", "minimum": 1, "maximum": 600 },
        "instructions": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "subjectType": { "type": "string", "minLength": 1 }
      }
    },
    "bookReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "pages": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "teaching": {
      "type": "object",
      "additionalProperties": false,
      "required": ["whyItMatters", "connections", "conceptVisuals", "deepDive", "warmupVisuals", "exerciseVisuals", "commonMistakes", "selfCheck", "sources"],
      "properties": {
        "whyItMatters": { "type": "string", "minLength": 1 },
        "connections": { "type": "string", "minLength": 1 },
        "conceptVisuals": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/visual" } },
        "deepDive": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
        "warmupVisuals": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/visual" } },
        "exerciseVisuals": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/visual" } },
        "commonMistakes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/mistake" } },
        "selfCheck": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/lessonSource" } }
      }
    },
    "mistake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mistake", "lookFor", "visual"],
      "properties": {
        "mistake": { "type": "string", "minLength": 1 },
        "lookFor": { "type": "string", "minLength": 1 },
        "visual": { "$ref": "#/$defs/visual" }
      }
    },
    "lessonSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "author", "edition", "pages", "usedFor", "sections"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "edition": { "type": "string", "minLength": 1 },
        "pages": { "type": "string", "minLength": 1 },
        "usedFor": { "type": "string", "minLength": 1 },
        "sections": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["concept", "deepDive", "warmup", "exercise", "mistakes"] } },
        "visualInfluence": { "type": "string" }
      }
    },
    "privateSourceImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceId", "page", "section"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sourceId": { "$ref": "#/$defs/id" },
        "page": { "type": "string", "minLength": 1 },
        "section": { "enum": ["concept", "deepDive", "warmup", "exercise", "mistakes"] }
      }
    }
  }
}
