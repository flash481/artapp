{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://art-course.local/schemas/lesson.v4.schema.json",
  "title": "Art course lesson record",
  "description": "Version 4 production contract for core-NNN canonical lessons, including unpublished text-stage drafts. Historical lesson-NN MVP prototypes and development fixtures remain legacy reference records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "durationMinutes",
    "difficulty",
    "medium",
    "materials",
    "lessonType",
    "fundamentals",
    "concepts",
    "prerequisites",
    "objective",
    "explanation",
    "visuals",
    "exercise",
    "artistReferences",
    "bookReferences",
    "reflection",
    "status",
    "label"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "durationMinutes": { "type": "integer", "minimum": 1, "maximum": 600 },
    "difficulty": { "type": "string", "minLength": 1 },
    "medium": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "materials": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "lessonType": { "type": "string", "minLength": 1 },
    "fundamentals": { "$ref": "#/$defs/fundamentals" },
    "concepts": { "type": "array", "items": { "$ref": "#/$defs/concept" } },
    "prerequisites": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "objective": { "type": "string", "minLength": 1 },
    "haveReady": { "$ref": "#/$defs/haveReady" },
    "warmup": { "$ref": "#/$defs/warmup" },
    "explanation": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "visuals": { "type": "array", "items": { "$ref": "#/$defs/visual" } },
    "exercise": { "$ref": "#/$defs/exercise" },
    "artistReferences": { "type": "array", "items": { "type": "string" } },
    "bookReferences": { "type": "array", "items": { "$ref": "#/$defs/bookReference" } },
    "reflection": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "teaching": { "$ref": "#/$defs/teaching" },
    "authoring": {
      "type": "object",
      "description": "Non-source lesson-production metadata, stripped by the application build. Private evidence and working briefs stay under sources/production/.",
      "additionalProperties": false,
      "required": ["canonicalNumber", "prerequisiteCapabilities", "laterReturns", "timingBudget"],
      "properties": {
        "canonicalNumber": { "type": "integer", "minimum": 1, "maximum": 150 },
        "prerequisiteCapabilities": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "laterReturns": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "timingBudget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["setupAndReading", "looking", "warmup", "drawing", "compareAndCorrect", "review", "reserve"],
          "properties": {
            "setupAndReading": { "type": "integer", "minimum": 1 },
            "looking": { "type": "integer", "minimum": 1 },
            "warmup": { "type": "integer", "minimum": 0 },
            "drawing": { "type": "integer", "minimum": 1 },
            "compareAndCorrect": { "type": "integer", "minimum": 1 },
            "review": { "type": "integer", "minimum": 1 },
            "reserve": { "type": "integer", "minimum": 5 }
          }
        }
      }
    },
    "sourceImages": { "type": "array", "items": { "$ref": "#/$defs/privateSourceImage" } },
    "extension": { "type": "string" },
    "scaffoldingLevel": { "type": "string" },
    "status": { "enum": ["development-fixture", "draft", "published"] },
    "label": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "development-fixture" } }, "required": ["status"] },
      "then": { "properties": { "label": { "const": "DEVELOPMENT FIXTURE — NOT FINAL CURRICULUM" } } }
    },
    {
      "if": {
        "properties": {
          "status": { "enum": ["draft", "published"] },
          "id": { "pattern": "^core-[0-9]{3}$" }
        },
        "required": ["status", "id"]
      },
      "then": {
        "required": ["teaching", "haveReady", "authoring"],
        "not": { "required": ["sourceImages"] },
        "properties": {
          "bookReferences": { "maxItems": 0 },
          "teaching": { "required": ["compare", "correct"] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "published" },
          "id": { "pattern": "^core-[0-9]{3}$" }
        },
        "required": ["status", "id"]
      },
      "then": { "properties": { "label": { "const": "" } } }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "draft" },
          "id": { "pattern": "^core-[0-9]{3}$" }
        },
        "required": ["status", "id"]
      },
      "then": { "properties": { "label": { "const": "DRAFT — NOT FOR LEARNERS" } } }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1
    },
    "conceptStage": {
      "type": "string",
      "enum": ["introduced", "practised", "revisited", "combined", "independent"]
    },
    "fundamentals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary"],
      "properties": {
        "primary": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "secondary": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "stage"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "stage": { "$ref": "#/$defs/conceptStage" }
      }
    },
    "warmup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durationMinutes", "instructions"],
      "properties": {
        "durationMinutes": { "type": "integer", "minimum": 1, "maximum": 60 },
        "instructions": { "type": "string", "minLength": 1 }
      }
    },
    "haveReady": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "setup", "referenceRoute", "fallbackVisual"],
      "properties": {
        "subject": { "type": "string", "minLength": 1 },
        "setup": { "type": "string", "minLength": 1 },
        "referenceRoute": { "type": "string", "minLength": 1 },
        "fallbackVisual": { "$ref": "#/$defs/visual" }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "alt", "provenance"],
      "properties": {
        "src": { "type": "string", "minLength": 1 },
        "alt": { "type": "string", "minLength": 1 },
        "caption": { "type": "string" },
        "provenance": { "$ref": "#/$defs/inlineProvenance" }
      }
    },
    "inlineProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "creator": { "type": "string" },
        "license": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durationMinutes", "instructions", "source", "subjectType"],
      "properties": {
        "durationMinutes": { "type": "integer", "minimum": 1, "maximum": 600 },
        "instructions": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "subjectType": { "type": "string", "minLength": 1 }
      }
    },
    "bookReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "pages": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "teaching": {
      "type": "object",
      "additionalProperties": false,
      "required": ["whyItMatters", "connections", "selfCheck"],
      "properties": {
        "whyItMatters": { "type": "string", "minLength": 1 },
        "connections": { "type": "string", "minLength": 1 },
        "conceptVisuals": { "type": "array", "items": { "$ref": "#/$defs/visual" } },
        "deepDive": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "warmupVisuals": { "type": "array", "items": { "$ref": "#/$defs/visual" } },
        "exerciseVisuals": { "type": "array", "items": { "$ref": "#/$defs/visual" } },
        "commonMistakes": { "type": "array", "items": { "$ref": "#/$defs/mistake" } },
        "compare": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "correct": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "selfCheck": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/lessonSource" } }
      }
    },
    "mistake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mistake", "lookFor"],
      "properties": {
        "mistake": { "type": "string", "minLength": 1 },
        "lookFor": { "type": "string", "minLength": 1 },
        "visual": { "$ref": "#/$defs/visual" }
      }
    },
    "lessonSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "author", "edition", "pages", "usedFor", "sections"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "edition": { "type": "string", "minLength": 1 },
        "pages": { "type": "string", "minLength": 1 },
        "usedFor": { "type": "string", "minLength": 1 },
        "sections": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["concept", "deepDive", "warmup", "exercise", "compare", "correct", "mistakes"] } },
        "visualInfluence": { "type": "string" }
      }
    },
    "privateSourceImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceId", "page", "section"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sourceId": { "$ref": "#/$defs/id" },
        "page": { "type": "string", "minLength": 1 },
        "section": { "enum": ["concept", "deepDive", "warmup", "exercise", "compare", "correct", "mistakes"] }
      }
    }
  }
}
