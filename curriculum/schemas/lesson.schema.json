{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://art-course.local/schemas/lesson.schema.json",
  "title": "Art course lesson record",
  "description": "Phase 1 app data contract. The status and label are deliberately fixed to make the three development fixtures unmistakable; expand the lifecycle contract before Phase 2 authoring.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "durationMinutes",
    "difficulty",
    "medium",
    "materials",
    "lessonType",
    "fundamentals",
    "concepts",
    "prerequisites",
    "objective",
    "warmup",
    "explanation",
    "visuals",
    "exercise",
    "artistReferences",
    "bookReferences",
    "reflection",
    "status",
    "label"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "durationMinutes": { "type": "integer", "minimum": 1, "maximum": 600 },
    "difficulty": { "type": "string", "minLength": 1 },
    "medium": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "materials": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "lessonType": { "type": "string", "minLength": 1 },
    "fundamentals": { "$ref": "#/$defs/fundamentals" },
    "concepts": { "type": "array", "items": { "$ref": "#/$defs/concept" } },
    "prerequisites": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "objective": { "type": "string", "minLength": 1 },
    "warmup": { "$ref": "#/$defs/warmup" },
    "explanation": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "visuals": { "type": "array", "items": { "$ref": "#/$defs/visual" } },
    "exercise": { "$ref": "#/$defs/exercise" },
    "artistReferences": { "type": "array", "items": { "type": "string" } },
    "bookReferences": { "type": "array", "items": { "$ref": "#/$defs/bookReference" } },
    "reflection": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "extension": { "type": "string" },
    "scaffoldingLevel": { "type": "string" },
    "status": { "const": "development-fixture" },
    "label": { "const": "DEVELOPMENT FIXTURE — NOT FINAL CURRICULUM" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1
    },
    "conceptStage": {
      "type": "string",
      "enum": ["introduced", "practised", "revisited", "combined", "independent"]
    },
    "fundamentals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary"],
      "properties": {
        "primary": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "secondary": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "stage"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "stage": { "$ref": "#/$defs/conceptStage" }
      }
    },
    "warmup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durationMinutes", "instructions"],
      "properties": {
        "durationMinutes": { "type": "integer", "minimum": 1, "maximum": 60 },
        "instructions": { "type": "string", "minLength": 1 }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "alt", "provenance"],
      "properties": {
        "src": { "type": "string", "minLength": 1 },
        "alt": { "type": "string", "minLength": 1 },
        "caption": { "type": "string" },
        "provenance": { "$ref": "#/$defs/inlineProvenance" }
      }
    },
    "inlineProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "creator": { "type": "string" },
        "license": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durationMinutes", "instructions", "source", "subjectType"],
      "properties": {
        "durationMinutes": { "type": "integer", "minimum": 1, "maximum": 600 },
        "instructions": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "subjectType": { "type": "string", "minLength": 1 }
      }
    },
    "bookReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "pages": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
